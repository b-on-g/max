$bog_max_app $mol_book2
	bot_prod \
	attr *
		^
		max_platform <= platform \web
	plugins /
		<= Theme $bog_theme_auto
			theme_light \$mol_theme_calm_light
			theme_dark \$mol_theme_calm_dark
			themes /
				\$mol_theme_calm_light
				\$mol_theme_calm_dark
	pages /
	Home $mol_page
		title @ \Мои заявки
		tools /
			<= Sync $giper_baza_status
		body <= home_body /
		foot /
			<= New_link $mol_link
				arg *
					screen \new
					ticket null
				sub /
					<= New_button $mol_button_major
						title @ \Новая заявка
	Fail $mol_paragraph
		title <= fail \
	House_title $mol_paragraph
		title <= house_title \
	Empty $mol_paragraph
		title @ \Заявок пока нет. Нажмите «Новая заявка», чтобы сообщить о проблеме в доме.
	Rows $mol_list
		rows <= rows /
			<= Row* $mol_link
				arg *
					ticket <= row_link* \
					screen null
				sub /
					<= Row_title* $mol_paragraph
						title <= row_title* \
					<= Row_status* $mol_paragraph
						title <= row_status* \
	New $mol_page
		title @ \Новая заявка
		tools /
			<= Close_new $mol_link
				arg *
					screen null
				sub /
					<= Close_new_icon $mol_icon_close
		body /
			<= Form $mol_form
				submit_allowed <= submit_allowed false
				form_fields /
					<= House_field $mol_form_field
						name @ \Дом
						control <= House $mol_select
							options <= house_options /string
							dictionary <= house_dictionary *
							value? <=> house? \
					<= Category_field $mol_form_field
						name @ \Что случилось
						control <= Category $mol_select
							options <= category_options /string
							dictionary <= category_dictionary *
							value? <=> category? \
					<= Place_field $mol_form_field
						name @ \Где
						control <= Place $mol_string
							hint @ \Подъезд, этаж, квартира
							value? <=> place? \
					<= Text_field $mol_form_field
						name @ \Подробности
						control <= Text $mol_string
							hint @ \Что именно не так
							value? <=> text? \
				buttons /
					<= Submit $mol_button_major
						title @ \Отправить заявку
						click? <=> submit? null
						enabled <= submit_allowed
	Ticket $mol_page
		title <= ticket_title \
		tools /
			<= Close_ticket $mol_link
				arg *
					ticket null
				sub /
					<= Close_ticket_icon $mol_icon_close
		body /
			<= Ticket_status $mol_paragraph
				title <= ticket_status \
			<= Ticket_category $mol_labeler
				title @ \Категория
				content / <= ticket_category \
			<= Ticket_house $mol_labeler
				title @ \Дом
				content / <= ticket_house \
			<= Ticket_place $mol_labeler
				title @ \Где
				content / <= ticket_place \
			<= Ticket_text $mol_labeler
				title @ \Подробности
				content / <= ticket_text \
			<= Ticket_owner $mol_labeler
				title @ \Ответственный
				content / <= ticket_owner \
			<= Ticket_react $mol_labeler
				title @ \Реакция по нормативу
				content / <= ticket_react \
			<= Ticket_fix $mol_labeler
				title @ \Устранение по нормативу
				content / <= ticket_fix \
			<= Ticket_basis $mol_labeler
				title @ \Основание
				content / <= ticket_basis \
			<= Log $mol_list
				rows <= log_rows /
					<= Log_row* $mol_paragraph
						title <= log_row* \
